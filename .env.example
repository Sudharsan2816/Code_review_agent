# ── GitHub ───────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_your_personal_access_token
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Choose "claude" (default) or "openai"
LLM_PROVIDER=claude

# Anthropic / Claude
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key
CLAUDE_MODEL=claude-sonnet-4-6

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your_openai_key
OPENAI_MODEL=gpt-4o

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=code_review_agent

# ── Behaviour ────────────────────────────────────────────────────────────────
# Set to true to hold reviews for manual approval before posting to GitHub
REQUIRE_HUMAN_APPROVAL=false

# Maximum diff characters forwarded to the LLM (prevents token overflow)
MAX_DIFF_CHARS=80000

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
